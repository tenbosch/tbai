GOOGLE_CLIENT_ID=
# From the same OAuth client in Google Cloud Console — required only for the
# optional "Connect Google services" feature (Calendar/Gmail/Drive read-only).
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
ADMIN_EMAILS=
# Must match the exact origin the app is served from. Never set to "*" —
# CORS is the only protection against non-browser cross-origin access.
CORS_ORIGIN=https://localhost:5173
BRAVE_API_KEY=

# ── Databricks-hosted models (OpenAI-compatible AI Gateway) ───────────────────
# All optional and read lazily: without the client id/secret the models simply
# don't appear in /models. Available to every whitelisted user (unlike the
# admin-only ANTHROPIC_* cloud models).
#
# Auth is OAuth M2M against a Databricks *service principal* — no personal
# access token. Create one under Settings → Identity and access → Service
# principals, then generate an OAuth secret for it, and grant it CAN_QUERY on
# the model you list below.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Workspace AI Gateway base URL — must end at /v1; the client appends
# /chat/completions. e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com/ai-gateway/mlflow/v1
DATABRICKS_BASE_URL=
# Comma-separated model names (default: tenbosch.tbai.kimi3). A Unity Catalog
# model is addressed by its full catalog.schema.name.
DATABRICKS_MODELS=tenbosch.tbai.kimi3
# Optional. The OIDC host is derived from DATABRICKS_BASE_URL; set this only if
# your gateway URL sits on a different host than the workspace itself.
#DATABRICKS_HOST=
# Optional. Defaults to all-apis; narrower workspace scopes such as
# model-serving-inference also exist.
#DATABRICKS_OAUTH_SCOPE=
